#include <stdio.h>

/* =====================================================
   DIGITAL LOGIC CIRCUIT SIMULATOR
   ===================================================== */

/* ================= LOGIC GATES ================= */

int AND(int a, int b)
{
    return a && b;
}

int OR(int a, int b)
{
    return a || b;
}

int NOT(int a)
{
    return !a;
}

int NAND(int a, int b)
{
    return !(a && b);
}

int NOR(int a, int b)
{
    return !(a || b);
}

int XOR(int a, int b)
{
    return a ^ b;
}

int XNOR(int a, int b)
{
    return !(a ^ b);
}


/* ================= HALF ADDER ================= */

void halfAdder(int a, int b)
{
    int sum, carry;

    sum = a ^ b;
    carry = a & b;

    printf("\n--- HALF ADDER ---\n");
    printf("A       = %d\n", a);
    printf("B       = %d\n", b);
    printf("Sum     = %d\n", sum);
    printf("Carry   = %d\n", carry);
}


/* ================= FULL ADDER ================= */

void fullAdder(int a, int b, int cin)
{
    int sum, carry;

    sum = a ^ b ^ cin;
    carry = (a & b) | (b & cin) | (a & cin);

    printf("\n--- FULL ADDER ---\n");
    printf("A         = %d\n", a);
    printf("B         = %d\n", b);
    printf("Carry In  = %d\n", cin);
    printf("Sum       = %d\n", sum);
    printf("Carry Out = %d\n", carry);
}


/* ================= HALF SUBTRACTOR ================= */

void halfSubtractor(int a, int b)
{
    int difference, borrow;

    difference = a ^ b;
    borrow = (!a) & b;

    printf("\n--- HALF SUBTRACTOR ---\n");
    printf("A          = %d\n", a);
    printf("B          = %d\n", b);
    printf("Difference = %d\n", difference);
    printf("Borrow     = %d\n", borrow);
}


/* ================= FULL SUBTRACTOR ================= */

void fullSubtractor(int a, int b, int bin)
{
    int difference, borrow;

    difference = a ^ b ^ bin;
    borrow = ((!a) & b) | ((!a) & bin) | (b & bin);

    printf("\n--- FULL SUBTRACTOR ---\n");
    printf("A          = %d\n", a);
    printf("B          = %d\n", b);
    printf("Borrow In  = %d\n", bin);
    printf("Difference = %d\n", difference);
    printf("Borrow Out = %d\n", borrow);
}


/* ================= 4-BIT ADDER ================= */

void fourBitAdder()
{
    int a[4], b[4];
    int sum[4];
    int carry = 0;
    int i;

    printf("\n--- 4-BIT BINARY ADDER ---\n");

    printf("Enter 4 bits for A (MSB to LSB): ");
    for (i = 0; i < 4; i++)
        scanf("%d", &a[i]);

    printf("Enter 4 bits for B (MSB to LSB): ");
    for (i = 0; i < 4; i++)
        scanf("%d", &b[i]);

    for (i = 3; i >= 0; i--)
    {
        sum[i] = a[i] ^ b[i] ^ carry;
        carry = (a[i] & b[i]) |
                (b[i] & carry) |
                (a[i] & carry);
    }

    printf("\nA   = ");
    for (i = 0; i < 4; i++)
        printf("%d", a[i]);

    printf("\nB   = ");
    for (i = 0; i < 4; i++)
        printf("%d", b[i]);

    printf("\nSum = ");
    for (i = 0; i < 4; i++)
        printf("%d", sum[i]);

    printf("\nCarry Out = %d\n", carry);
}


/* ================= TRUTH TABLES ================= */

void displayTruthTables()
{
    int a, b;

    printf("\n==============================================");
    printf("\n              LOGIC GATE TRUTH TABLES");
    printf("\n==============================================\n");

    printf("\nA B | AND OR NAND NOR XOR XNOR\n");
    printf("--------------------------------\n");

    for (a = 0; a <= 1; a++)
    {
        for (b = 0; b <= 1; b++)
        {
            printf("%d %d |  %d   %d    %d    %d   %d    %d\n",
                   a, b,
                   AND(a, b),
                   OR(a, b),
                   NAND(a, b),
                   NOR(a, b),
                   XOR(a, b),
                   XNOR(a, b));
        }
    }

    printf("\nNOT Gate\n");
    printf("--------\n");
    printf("A | NOT\n");
    printf("--------\n");

    for (a = 0; a <= 1; a++)
    {
        printf("%d |  %d\n", a, NOT(a));
    }

    printf("\nHalf Adder\n");
    printf("----------------\n");
    printf("A B | Sum Carry\n");
    printf("----------------\n");

    for (a = 0; a <= 1; a++)
    {
        for (b = 0; b <= 1; b++)
        {
            printf("%d %d |  %d    %d\n",
                   a, b,
                   a ^ b,
                   a & b);
        }
    }

    printf("\nFull Adder\n");
    printf("------------------------\n");
    printf("A B Cin | Sum Carry\n");
    printf("------------------------\n");

    {
        int cin;

        for (a = 0; a <= 1; a++)
        {
            for (b = 0; b <= 1; b++)
            {
                for (cin = 0; cin <= 1; cin++)
                {
                    printf("%d %d  %d  |  %d    %d\n",
                           a, b, cin,
                           a ^ b ^ cin,
                           (a & b) | (b & cin) | (a & cin));
                }
            }
        }
    }

    printf("\nHalf Subtractor\n");
    printf("--------------------\n");
    printf("A B | Difference Borrow\n");
    printf("--------------------\n");

    for (a = 0; a <= 1; a++)
    {
        for (b = 0; b <= 1; b++)
        {
            printf("%d %d |     %d        %d\n",
                   a, b,
                   a ^ b,
                   (!a) & b);
        }
    }

    printf("\nFull Subtractor\n");
    printf("-----------------------------\n");
    printf("A B Bin | Difference Borrow\n");
    printf("-----------------------------\n");

    {
        int bin;

        for (a = 0; a <= 1; a++)
        {
            for (b = 0; b <= 1; b++)
            {
                for (bin = 0; bin <= 1; bin++)
                {
                    printf("%d %d  %d  |     %d        %d\n",
                           a, b, bin,
                           a ^ b ^ bin,
                           ((!a) & b) |
                           ((!a) & bin) |
                           (b & bin));
                }
            }
        }
    }
}


/* ================= MAIN PROGRAM ================= */

