#include <stdio.h>

/* ================= LOGIC GATE FUNCTIONS ================= */

int AND(int a, int b)
{
    return a && b;
}

int OR(int a, int b)
{
    return a || b;
}

int NOT(int a)
{
    return !a;
}

int NAND(int a, int b)
{
    return !(a && b);
}

int NOR(int a, int b)
{
    return !(a || b);
}

int XOR(int a, int b)
{
    return a ^ b;
}

int XNOR(int a, int b)
{
    return !(a ^ b);
}

/* ================= HALF ADDER ================= */

void halfAdder(int a, int b)
{
    int sum, carry;

    sum = a ^ b;
    carry = a & b;

    printf("\n--- HALF ADDER ---\n");
    printf("A = %d\n", a);
    printf("B = %d\n", b);
    printf("Sum   = %d\n", sum);
    printf("Carry = %d\n", carry);
}

/* ================= TRUTH TABLES ================= */

void displayTruthTables()
{
    int a, b;

    printf("\n========================================");
    printf("\n          LOGIC GATE TRUTH TABLES");
    printf("\n========================================\n");

    printf("\nA B | AND OR NAND NOR XOR XNOR\n");
    printf("--------------------------------\n");

    for (a = 0; a <= 1; a++)
    {
        for (b = 0; b <= 1; b++)
        {
            printf("%d %d |  %d   %d    %d    %d   %d    %d\n",
                   a, b,
                   AND(a, b),
                   OR(a, b),
                   NAND(a, b),
                   NOR(a, b),
                   XOR(a, b),
                   XNOR(a, b));
        }
    }

    printf("\nNOT Gate Truth Table\n");
    printf("-------------------\n");
    printf("A | NOT\n");
    printf("--------\n");

    for (a = 0; a <= 1; a++)
    {
        printf("%d |  %d\n", a, NOT(a));
    }

    printf("\nHalf Adder Truth Table\n");
    printf("----------------------\n");
    printf("A B | Sum Carry\n");
    printf("----------------\n");

    for (a = 0; a <= 1; a++)
    {
        for (b = 0; b <= 1; b++)
        {
            printf("%d %d |  %d    %d\n",
                   a, b,
                   XOR(a, b),
                   AND(a, b));
        }
    }
}

/* ================= MAIN PROGRAM ================= */

int main()
{
    int choice;
    int a, b;

    while (1)
    {
        printf("\n\n========================================");
        printf("\n       DIGITAL LOGIC CIRCUIT SIMULATOR");
        printf("\n========================================");

        printf("\n1. AND Gate");
        printf("\n2. OR Gate");
        printf("\n3. NOT Gate");
        printf("\n4. NAND Gate");
        printf("\n5. NOR Gate");
        printf("\n6. XOR Gate");
        printf("\n7. XNOR Gate");
        printf("\n8. Display All Truth Tables");
        printf("\n9. Half Adder");
        printf("\n10. Exit");

        printf("\n\nEnter your choice: ");
        scanf("%d", &choice);

        /* -------- LOGIC GATES -------- */

        if (choice >= 1 && choice <= 7)
        {
            printf("\nEnter input A (0 or 1): ");
            scanf("%d", &a);

            if (choice != 3)
            {
                printf("Enter input B (0 or 1): ");
                scanf("%d", &b);
            }

            switch (choice)
            {
                case 1:
                    printf("AND Output = %d\n", AND(a, b));
                    break;

                case 2:
                    printf("OR Output = %d\n", OR(a, b));
                    break;

                case 3:
                    printf("NOT Output = %d\n", NOT(a));
                    break;

                case 4:
                    printf("NAND Output = %d\n", NAND(a, b));
                    break;

                case 5:
                    printf("NOR Output = %d\n", NOR(a, b));
                    break;

                case 6:
                    printf("XOR Output = %d\n", XOR(a, b));
                    break;

                case 7:
                    printf("XNOR Output = %d\n", XNOR(a, b));
                    break;
            }
        }

        /* -------- TRUTH TABLES -------- */

        else if (choice == 8)
        {
            displayTruthTables();
        }

        /* -------- HALF ADDER -------- */

        else if (choice == 9)
        {
            printf("\nEnter input A (0 or 1): ");
            scanf("%d", &a);

            printf("Enter input B (0 or 1): ");
            scanf("%d", &b);

            halfAdder(a, b);
        }

        /* -------- EXIT -------- */

        else if (choice == 10)
        {
            printf("\nThank you for using the Digital Logic Circuit Simulator!\n");
            break;
        }

        else
        {
            printf("\nInvalid choice! Please enter 1 to 10.\n");
        }
    }

    return 0;
}
