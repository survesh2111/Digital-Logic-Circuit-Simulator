                    printf("AND Output = %d\n", AND(a, b));
                    break;

                case 2:
                    printf("OR Output = %d\n", OR(a, b));
                    break;

                case 3:
                    printf("NOT Output = %d\n", NOT(a));
                    break;

                case 4:
                    printf("NAND Output = %d\n", NAND(a, b));
                    break;

                case 5:
                    printf("NOR Output = %d\n", NOR(a, b));
                    break;

                case 6:
                    printf("XOR Output = %d\n", XOR(a, b));
                    break;

                case 7:
                    printf("XNOR Output = %d\n", XNOR(a, b));
                    break;
            }
        }


        /* ========== TRUTH TABLES ========== */

        else if (choice == 8)
        {
            displayTruthTables();
        }


        /* ========== HALF ADDER ========== */

        else if (choice == 9)
        {
            printf("\nEnter input A (0 or 1): ");
            scanf("%d", &a);

            printf("Enter input B (0 or 1): ");
            scanf("%d", &b);

            halfAdder(a, b);
        }


        /* ========== FULL ADDER ========== */

        else if (choice == 10)
        {
            printf("\nEnter input A (0 or 1): ");
            scanf("%d", &a);

            printf("Enter input B (0 or 1): ");
            scanf("%d", &b);

            printf("Enter Carry In (0 or 1): ");
            scanf("%d", &cin);

            fullAdder(a, b, cin);
        }


        /* ========== HALF SUBTRACTOR ========== */

        else if (choice == 11)
        {
            printf("\nEnter input A (0 or 1): ");
            scanf("%d", &a);

            printf("Enter input B (0 or 1): ");
            scanf("%d", &b);

            halfSubtractor(a, b);
        }


        /* ========== FULL SUBTRACTOR ========== */

        else if (choice == 12)
        {
            printf("\nEnter input A (0 or 1): ");
            scanf("%d", &a);

            printf("Enter input B (0 or 1): ");
            scanf("%d", &b);

            printf("Enter Borrow In (0 or 1): ");
            scanf("%d", &bin);

            fullSubtractor(a, b, bin);
        }


        /* ========== 4-BIT ADDER ========== */

        else if (choice == 13)
        {
            fourBitAdder();
        }


        /* ========== EXIT ========== */

        else if (choice == 14)
        {
            printf("\nThank you for using the Digital Logic Circuit Simulator!\n");
            break;
        }


        /* ========== INVALID CHOICE ========== */

        else
        {
            printf("\nInvalid choice! Please enter 1 to 14.\n");
        }
    }

    return 0;
}
